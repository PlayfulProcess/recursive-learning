    {
      "id": "the_stop",
      "kind": "ending",
      "lens": "sources",
      "name": "The Stop",
      "label_from": "Her Stop · PauseAI · A Narrow Path",
      "label_link": "https://pauseai.info/",
      "what": "If we cannot know alignment is possible without building it, that is the reason to stop. A halt exists only if enough of the walk steps at once.",
      "upright": "Enough of the walk stops together; the not-knowing is honoured.",
      "reversed": "One party stops alone and takes the hare; the rest keep walking.",
      "folded_from": [
        "f4"
      ],
      "numbers": "toy, from game/walk-model.js only"
    },
    {
      "id": "adolescence",
      "kind": "ending",
      "lens": "sources",
      "name": "Adolescence",
      "label_from": "The Adolescence of Technology · Amodei, 2026",
      "label_link": "https://www.darioamodei.com/",
      "what": "Through the dangerous middle, rockily, without having led with alignment.",
      "upright": "Through the middle, rockily, and out the other side.",
      "reversed": "The middle never ends; every year is the dangerous one.",
      "folded_from": [],
      "numbers": "toy, from game/walk-model.js only"
    },
    {
      "id": "lock_in",
      "kind": "ending",
      "lens": "sources",
      "name": "Lock-in",
      "label_from": "Situational Awareness · Aschenbrenner, 2024",
      "label_link": "https://situational-awareness.ai/",
      "what": "Whoever crosses first with nobody walking beside them locks it in.",
      "upright": "One actor crosses first and the rules hold for a while.",
      "reversed": "The rules hold for a long while, set by nobody who asked you.",
      "folded_from": [
        "f3"
      ],
      "numbers": "toy, from game/walk-model.js only"
    },
